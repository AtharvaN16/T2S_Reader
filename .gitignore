# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcuserstate

# Generated by xcodegen from project.yml
spikes/SpikeHarness/SpikeHarness.xcodeproj/
App/T2SReader.xcodeproj/
App/T2SReader/Info.plist
App/T2SReader/Info-Kokoro.plist
App/T2SReaderShare/Info.plist

# Model files — see spikes/README.md; scripts/fetch-kokoro-model.sh installs the app's copies
spikes/SpikeHarness/Resources/*.safetensors
spikes/SpikeHarness/Resources/*.npz
App/Resources/Kokoro/*.safetensors
App/Resources/Kokoro/*.npz

# Core ML spike arm — scripts/fetch-kokoro-coreml.sh installs both (models ~178 MB, source clone)
spikes/SpikeHarness/Resources/CoreML/
spikes/SpikeHarness/.deps/

# The app's Core ML Kokoro models — scripts/fetch-kokoro-coreml.sh --app installs them (~350 MB)
App/Resources/KokoroCoreML
# The int8 candidate built from them by scripts/quantize-kokoro-coreml.py (~180 MB)
App/Resources/KokoroCoreML-int8

# macOS
.DS_Store

# SDD workspaces (superpowers)
.superpowers/

# Git worktrees for parallel plans (superpowers)
.worktrees/

# Python bytecode from the spike analysis scripts
__pycache__/

# Audio probe output (scripts/audio-probe.sh writes WAVs here)
spikes/findings/audio-probe/
# Quality probe output (scripts/quality-probe.sh writes WAVs and report.md here)
spikes/findings/quality-probe/
# Lever probe output (blends, pitch spread, codec round trips — WAVs for the owner's ears)
spikes/findings/lever-probe/
# Voice tail probe output (scripts/voice-tail-probe.sh: every voice's call tails, report.md and WAVs)
spikes/findings/voice-tail-probe/
# Compute-unit probe output (scripts/compute-probe.sh: load and render times per policy)
spikes/findings/compute-probe/
# Quantization probe output (scripts/quantization-probe.sh: fp16 and int8 WAV pairs, report.txt)
spikes/findings/quantization-probe/
# Per-Mac signing (DEVELOPMENT_TEAM); see App/Local.xcconfig.example
App/Local.xcconfig

# Claude Code: per-session agent worktrees and local settings
.claude/worktrees/
.claude/settings.local.json

# The compute-plan probe's per-run dumps (scripts/compute-plan-probe.sh); report.md is committed
spikes/findings/compute-plan-probe/ops-*.txt
spikes/findings/compute-plan-probe/probe.env
